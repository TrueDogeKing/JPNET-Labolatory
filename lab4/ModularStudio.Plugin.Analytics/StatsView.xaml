<UserControl x:Class="ModularStudio.Plugin.Analytics.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock x:Name="TxtSource" Text="Oczekiwanie na dane..." FontStyle="Italic" />

            <TextBlock Text="Tekst" FontWeight="Bold" Margin="0,10,0,3" />
            <TextBlock x:Name="TxtChars" />
            <TextBlock x:Name="TxtWords" />
            <TextBlock Text="Najczęstsze słowa:" Margin="0,5,0,0" />
            <ItemsControl x:Name="TopWordsList" Margin="10,0,0,0" />

            <TextBlock Text="Pomiary" FontWeight="Bold" Margin="0,10,0,3" />
            <TextBlock x:Name="TxtNumStats" />

            <ItemsControl x:Name="BarsList" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" />
                            <ProgressBar Grid.Column="1" Height="12" Maximum="100"
                                         Value="{Binding Percent, Mode=OneWay}" />
                            <TextBlock Grid.Column="2" TextAlignment="Right"
                                       Text="{Binding Value, StringFormat=F2}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Audyt (zakres AnalysisScope)" FontWeight="Bold" Margin="0,15,0,3" />
            <TextBlock x:Name="TxtSession" TextWrapping="Wrap" />
            <TextBlock x:Name="TxtAuditSummary" />
            <ItemsControl x:Name="AnomaliesList" Margin="10,3,0,0" Foreground="DarkRed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>